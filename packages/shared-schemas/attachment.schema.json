{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aodcast.dev/schemas/attachment.schema.json",
  "title": "Attachment",
  "description": "A user-supplied chat attachment stored under its session as an immutable content-hashed blob. Images reach the model as image input; documents reach it as backend-extracted text. Attachments never become long-term memories.",
  "type": "object",
  "required": ["attachment_id", "session_id", "kind", "mime_type", "name", "size_bytes", "sha256", "created_at"],
  "properties": {
    "attachment_id": { "type": "string", "pattern": "^att_[a-f0-9]{32}$" },
    "session_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["image", "document"] },
    "mime_type": {
      "type": "string",
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "text/plain",
        "text/markdown",
        "text/csv",
        "application/json",
        "application/pdf"
      ]
    },
    "name": { "type": "string", "minLength": 1 },
    "size_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
