{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aodcast.dev/schemas/transcript.schema.json",
  "title": "Transcript",
  "type": "object",
  "required": ["session_id", "turns"],
  "properties": {
    "session_id": { "type": "string" },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn_id", "speaker", "content", "created_at"],
        "properties": {
          "turn_id": { "type": "string" },
          "speaker": { "type": "string", "enum": ["agent", "user"] },
          "content": {
            "type": "string",
            "description": "Turn text. May be empty only on a user turn that carries attachments."
          },
          "created_at": { "type": "string", "format": "date-time" },
          "metadata": {
            "type": "object",
            "description": "Non-sensitive prompt assembly metadata attached by interview orchestration (interview_focus, turn_role, prompt_version, prompt_section_ids).",
            "additionalProperties": true
          },
          "attachments": {
            "type": "array",
            "description": "User turns only. Attachments sent with this message; never a source of long-term memory.",
            "maxItems": 8,
            "items": { "$ref": "attachment.schema.json" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
