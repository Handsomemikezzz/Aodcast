{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aodcast.dev/schemas/memory-state.schema.json",
  "title": "MemoryOverview",
  "description": "Memory overview exposed across the bridge. Settings and worker state are persisted separately under .local-data/memory/.",
  "type": "object",
  "required": [
    "settings",
    "worker",
    "entry_count",
    "pending_job_count",
    "superseded_count"
  ],
  "properties": {
    "settings": {
      "type": "object",
      "required": [
        "first_run_acknowledged",
        "writing_enabled",
        "usage_enabled",
        "last_maintenance_at",
        "changes_since_maintenance"
      ],
      "properties": {
        "first_run_acknowledged": { "type": "boolean" },
        "writing_enabled": { "type": "boolean" },
        "usage_enabled": { "type": "boolean" },
        "last_maintenance_at": { "type": ["string", "null"], "format": "date-time" },
        "changes_since_maintenance": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "required": ["status", "last_error", "updated_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["idle", "running", "error"]
        },
        "last_error": { "type": "string" },
        "updated_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "entry_count": { "type": "integer", "minimum": 0 },
    "pending_job_count": { "type": "integer", "minimum": 0 },
    "superseded_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
