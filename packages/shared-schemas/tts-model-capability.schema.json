{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aodcast.dev/schemas/tts-model-capability.schema.json",
  "title": "TTSModelCapability",
  "description": "Adapter-declared model capabilities used for explicit feature negotiation.",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "model",
    "runtime",
    "adapter_version",
    "platforms",
    "languages",
    "reference_audio_formats",
    "output_audio_formats",
    "capabilities",
    "limits"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["macos_apple_silicon", "nvidia_cuda", "remote_api"]
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reference_audio_formats": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_audio_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "supportLevel": {
      "type": "string",
      "enum": ["native", "approximated", "unsupported"]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "speaker_cloning",
        "style_instruction",
        "emotion",
        "energy",
        "pace",
        "emphasis",
        "explicit_breaks",
        "pronunciation",
        "deterministic_seed",
        "text_context",
        "audio_context",
        "voice_conversion"
      ],
      "properties": {
        "speaker_cloning": { "$ref": "#/$defs/supportLevel" },
        "style_instruction": { "$ref": "#/$defs/supportLevel" },
        "emotion": { "$ref": "#/$defs/supportLevel" },
        "energy": { "$ref": "#/$defs/supportLevel" },
        "pace": { "$ref": "#/$defs/supportLevel" },
        "emphasis": { "$ref": "#/$defs/supportLevel" },
        "explicit_breaks": { "$ref": "#/$defs/supportLevel" },
        "pronunciation": { "$ref": "#/$defs/supportLevel" },
        "deterministic_seed": { "$ref": "#/$defs/supportLevel" },
        "text_context": { "$ref": "#/$defs/supportLevel" },
        "audio_context": { "$ref": "#/$defs/supportLevel" },
        "voice_conversion": { "$ref": "#/$defs/supportLevel" }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["max_reference_duration_ms", "max_segment_characters"],
      "properties": {
        "max_reference_duration_ms": { "type": ["integer", "null"], "minimum": 1 },
        "max_segment_characters": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
