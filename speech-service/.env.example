# Read before importing Hugging Face / MLX. Uncomment to use the mirror.
# HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_TELEMETRY=1
TOKENIZERS_PARALLELISM=false

HOST=127.0.0.1
PORT=8090
TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-CustomVoice-8bit
ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
TTS_VOICE=Vivian
TTS_LANGUAGE=Chinese
TTS_SEED=42
TTS_MAX_TOKENS=1024
# uv sync --extra kokoro, then set all three:
# TTS_MODEL=mlx-community/Kokoro-82M-bf16
# TTS_VOICE=zf_xiaobei
# TTS_LANGUAGE=z

IDLE_UNLOAD_SECONDS=900
# Free the other model before loading a new one (recommended for 16 GB).
SINGLE_MODEL_RESIDENT=true
# Allocator limits, not a reservation or an absolute bound on total process RSS.
MLX_MEMORY_LIMIT_GB=8
MLX_CACHE_LIMIT_MB=256
MIN_AVAILABLE_MEMORY_GB=2

MAX_TEXT_CHARS=20000
MAX_UPLOAD_MB=100
MAX_AUDIO_SECONDS=3600
ASR_CHUNK_SECONDS=25
ASR_MAX_TOKENS=1024
MAX_PENDING_REQUESTS=4
QUEUE_TIMEOUT_SECONDS=300
FFMPEG_TIMEOUT_SECONDS=120
PARAGRAPH_PAUSE_MS=300
CROSSFADE_MS=10
