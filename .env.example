# Aodcast optional local environment variables.
# The app stores provider settings through the local config UI/CLI.
# Never commit a real .env file or real provider credentials.

# Optional local HTTP runtime used by the Vite web shell (parallel worktrees).
VITE_AODCAST_RUNTIME_URL="http://127.0.0.1:8765"

# Optional absolute path to the official Codex executable when not discoverable.
AODCAST_CODEX_BIN=""

# Local speech uses provider local_http and http://127.0.0.1:8090/v1 by default.
# Optional default endpoint when no base URL has been saved in provider settings.
# Export this variable before starting Python; the Python core does not load .env.
# Vite loads VITE_AODCAST_RUNTIME_URL from its own environment separately.
AODCAST_SPEECH_URL="http://127.0.0.1:8090/v1"
# A saved --tts-base-url takes priority; do not configure model-weight paths here.
# Configure speech models, HF_ENDPOINT, and Hugging Face cache/token only in the
# bundled speech-service/.env, then run ./speech-service/service.sh restart.
# It has its own Python 3.12 environment; weights remain in the HF cache.
